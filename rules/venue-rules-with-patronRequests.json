        },
        "address": {
          ".write": "auth != null"
        },
        "businessName": {
          ".write": "auth != null"
        },
        "claimedAt": {
          ".write": "auth != null"
        },
        "claimedBy": {
          ".write": "auth != null"
        },
        "createdAt": {
          ".write": "auth != null"
        },
        "id": {
          ".write": "auth != null"
        },
        "lat": {
          ".write": "auth != null"
        },
        "lng": {
          ".write": "auth != null"
        },
        "name": {
          ".write": "auth != null"
        },
        "patronRequests": {
          ".write": "auth != null"
        },
        "records": {
          ".write": "auth != null"
        },
        "signals": {
          ".write": "auth != null"
        },
        "source": {
          ".write": "auth != null"
        },
        "staffSetup": {
          ".read": "auth != null",
