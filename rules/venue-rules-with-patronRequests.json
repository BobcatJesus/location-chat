            ".write": "auth != null && ((!data.exists() && newData.child('ownerUid').val() == auth.uid) || data.child('ownerUid').val() == auth.uid)"
          },
          "dispatchSettings": {
            ".write": "auth != null && data.parent().child('administratorAccount').child('ownerUid').val() == auth.uid"
          },
          "roster": {
            ".write": "auth != null && data.parent().child('administratorAccount').child('ownerUid').val() == auth.uid"
          }
        },
        "venueType": {
          ".write": "auth != null"
        }
      },
      ".read": "auth != null"
    }
