# Frontend API/socket endpoint used by Vite app
# Set this to your shared backend so public rooms sync across users
VITE_BACKEND_URL=https://location-chat-production.up.railway.app

# Supabase browser credentials for authentication and player profiles.
# Use the publishable/anon key; never put a service-role key in this file.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-only (put in .env.local / Railway, never VITE_-prefixed): Inworld Router NPC replies
INWORLD_API_KEY=your-inworld-api-key
INWORLD_MODEL=gemma-4-31b-it
INWORLD_REASONING_EFFORT=low
INWORLD_MAX_TOKENS=1024
INWORLD_TEMPERATURE=1.0
